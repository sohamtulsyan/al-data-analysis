# Retention Pipeline configuration (PRD Final.md §1)
# Copy to .env and fill in secrets. Never commit .env.

API_BASE_URL=https://puzzleme.amuselabs.com/pmm/api/v2
CLIENT_ID=
CLIENT_SECRET=
TIMEZONE=UTC
SERIES_ID=
# PUZZLE_ID=   # optional — omit to fetch entire series
TOTAL_DATA_TIME_START=2026-01-01T00:00:00
LIMIT=1000
OFFSET=0
# 0.5 requests/second ≈ 30 requests/minute
RATE_LIMIT_RPS=0.5
MAX_WORKERS=8

# Optional analysis defaults (also passable via CLI flags)
# TIMELINE_START=2026-01-01T00:00:00
# TIMELINE_END=2026-03-31T23:59:59
# GRAIN=Daily

# --- API server (retention_api/) ---
# DATA_DIR=Daily Play Data
# OUTPUT_DIR=output
# RUNTIME_CONFIG_PATH=data/runtime_config.json
# CORS_ORIGINS=http://localhost:5173
# JOB_MAX_WORKERS=2
# USERS_CSV_PATH=users_2026_07_16_12_34_42.csv
